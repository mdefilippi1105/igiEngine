@model VideoRecorder.Models.Server
@{
    ViewData["Title"] = "igiEngine Server";

    var online = Model != null && Model.IsEnabled;
    var lastSeen = Model?.LastSeenUtc;
    var stale = lastSeen == null || (DateTime.UtcNow - lastSeen.Value).TotalMinutes > 5;
}



<div style="display:flex; ">

    @*********************************************** 
    this is the entire tool bar starting at the div
    ***********************************************@
    <div style="width:200px; 
        min-width:200px; 
        background:#0d1117; 
        border-right:1px solid #330860; 
        padding:16px 12px; 
        display:flex; 
        flex-direction:column; 
        gap:8px;">

        <p style="font-size:22px; 
            color:#6e7a9a; 
            text-transform:uppercase; 
            letter-spacing:.07em;
            padding-bottom:10px;
            border-bottom:1px solid #1e2550;
            margin:0;">Home
        </p>

        <!-- Add a new recording server   -->
        <a asp-controller="Server"
           asp-action="AddServer"
           class="btn btn-sm btn-ffx srv-btn"
           style="margin-right:auto;">
            <img src="~/Images/addserver.png" alt="" width="45" height="45">
            Add Server
        </a>

        <!-- Edit your current recording server -->
        <a asp-controller="Server"
           asp-action="EditServer"
           class="btn btn-sm btn-ffx srv-btn"
           style="margin-right:auto;">
            <img src="~/Images/editserver.png" alt="" width="45" height="45">
            Edit Server
        </a>

        <!--Delete the server -->
        <a asp-controller="Server"
           asp-action="DeleteServer"
           class="btn btn-sm btn-ffx srv-btn"
           style="margin-right:auto;">
            <img src="~/Images/deleteserver.png" alt="" width="45" height="45">
            Remove Server
        </a>


        <!-- Server statistics -->
        <a asp-controller="Server"
           asp-action="ServerStatistics"
           class="btn btn-sm btn-ffx srv-btn"
           style="margin-right:auto;">
            <img src="~/Images/serverstats.png" alt="" width="65" height="45">
            Statistics
        </a>

        <!-- Go to home page   -->
        <a asp-controller="Home" 
           asp-action="Index" 
           class="btn btn-ffx" 
           style="background:#1e2550; 
                  border:1px solid #330860; 
                  color:#fafafa;
                  display:flex; 
                  align-items:center; 
                  gap:8px;">
            <img src="~/Images/home.png" alt="" width="45" height="45">
            igiEngine Home
        </a>

        <!-- Log Out   -->
        <a asp-controller="Account" 
           asp-action="Logout" 
           class="btn btn-ffx" 
           style="background:#1e2550; 
                   border:1px solid #330860; 
                   color:#fafafa;
                   display:flex; 
                   align-items:center; 
                   gap:15px;">
            <img src="~/Images/exit.png" alt="" width="45" height="45">
            Exit
        </a>
    </div>
    @* end tool bar *@


    @* ---------- server status panel ---------- *@
    <div class="status-wrap">

        @if (Model == null)
        {
            <div class="status-head">
                <span class="status-eyebrow">Recording servers</span>
                
                
            </div>
            <div class="empty">
                Add a server record to see its status here.
            </div>
        }
        else
        {
            <div class="status-head">
                <span class="status-eyebrow">Recording server</span>
                <h1>@Model.Name</h1>
                
                
                <span class="pill">
                    <span class="server-dot @(online ? (stale ? "warn" : "live") : "")"></span>
                    @(online ? (stale ? "No recent contact" : "Online") : "Disabled")
                </span>
            </div>

            <div class="field-grid">

                <div class="field">
                    <div class="field-label">Hostname</div>
                    <div class="field-value mono">@Model.Hostname</div>
                </div>

                <div class="field">
                    <div class="field-label">Port</div>
                    <div class="field-value mono">@Model.Port</div>
                </div>

                <div class="field">
                    <div class="field-label">Enabled</div>
                    <div class="field-value">@(Model.IsEnabled ? "Yes" : "No")</div>
                    <div class="field-sub">Operator setting, not live state</div>
                </div>

                <div class="field">
                    <div class="field-label">Last seen</div>
                    @if (lastSeen == null)
                    {
                        <div class="field-value">Never</div>
                        <div class="field-sub">Server has not checked in</div>
                    }
                    else
                    {
                        <div class="field-value mono">@lastSeen.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                        <div class="field-sub">@((int)(DateTime.UtcNow - lastSeen.Value).TotalMinutes) min ago</div>
                    }
                </div>

                <div class="field">
                    <div class="field-label">Cameras</div>
                    <div class="field-value">@Model.Cameras.Count</div>
                </div>

                <div class="field">
                    <div class="field-label">Server ID</div>
                    <div class="field-value mono">@Model.Id</div>
                </div>

            </div>
        }
    </div>

</div>
