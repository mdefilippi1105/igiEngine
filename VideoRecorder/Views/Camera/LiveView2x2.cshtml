@{
    ViewData["Title"] = "Live View 2X2";
}

<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; padding:12px; background:#1a1025; border-radius:12px;">
    
    @foreach (var cam in ViewBag.Cameras)
    {
        <!-- dark cell - purple border,clipped corners, 16:9 enforced, centers the "NO SIGNAL" placeholder -->
        <div style="position:relative; background:#0d0a16; border:1px solid #3C3489; border-radius:8px; overflow:hidden; aspect-ratio:16/9; display:flex; align-items:center; justify-content:center;">
            
            <!-- video fills the box; object-fit:cover crops rather than letterboxes -->
            <video id="video-@cam.Id" muted playsinline style="width:100%; height:100%; object-fit:cover;"></video>
            
            <!-- CAM-ID badge: absolute so it floats over the video, top-left corner -->
            <span style="position:absolute; top:8px; left:8px; font-size:10px; color:#7F77DD; font-family:monospace; opacity:.7;">CAM-@cam.Name</span>
            
            <!-- bottom bar: absolute, full width, gradient fades video into label so text stays readable -->
            <div style="position:absolute; bottom:0; left:0; right:0; padding:6px 10px; background:linear-gradient(transparent,rgba(13,10,22,.9)); display:flex; align-items:center; justify-content:space-between;">
               
                <!-- camera name, left side -->
                <span style="font-size:12px; font-weight:500; color:#AFA9EC; font-family:monospace;">@cam.Name</span>
                
                <span style="display:flex; align-items:center; gap:5px; font-size:11px; font-family:monospace; color:@(cam.IsOnline ? "#5DCAA5" : "#E24B4A");">
                    <span style="width:6px; height:6px; border-radius:50%; background:@(cam.IsOnline ? "#5DCAA5" : "#E24B4A"); display:inline-block;"></span>
                    @(cam.IsOnline ? "LIVE" : "OFFLINE")
                </span>
            </div>
        </div>    
    }
    
</div>


@************************************************************************
* find the video element, then create a new HLS player instance.
* tell HLS.js where the stream is. index.m3u8 is the playlist 
* file mediamtx generates - a text file that says where the video chunks are.
* listen for the event after playlist file is parsed
* next, we wait 5 secs for ffmpeg to connect
**************************************************************************@
@* <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script> *@

<script src="~/js/hls.min.js"></script>

<script>
    
    
    
    function startPlayer(cameraId) {
        const video = document.getElementById("video-" + cameraId);
        video.removeAttribute('src');
        
        const hls = new Hls({
            manifestLoadingMaxRetry: 10,
            manifestLoadingRetryDelay: 2000,
            manifestLoadingMaxRetryTimeout: 64000,
        });
        
        setTimeout(function() {
            hls.loadSource('http://localhost:8888/live/' + cameraId + '/index.m3u8');
            hls.attachMedia(video);
            hls.on(Hls.Events.MANIFEST_PARSED, function() {
                video.play();
            });
            
            hls.on(Hls.Events.ERROR, function(event, data) {
                if (data.details === Hls.ErrorDetails.MANIFEST_LOAD_ERROR ||
                    data.details === Hls.ErrorDetails.MANIFEST_LOAD_TIMEOUT) {
                    console.log('Retrying stream... attempt: ' + data.context.retryCount);
                }

                if (data.fatal) {
                    Swal.fire({
                        title: 'Stream unavailable.',
                        text: 'Could not connect to camera.',
                        icon: 'error',
                        background: '#1a1a2e',
                        color: '#ffffff'
                    });
                }
            });
        }, 5000);
    }
    
    @foreach (var cam in ViewBag.Cameras)
    {
        @:startPlayer("@cam.Id");
    }
    
</script>

@************************************************************************
* Javascript to listen for the "back button clicked".
* For this, we are using sendBeacon. sendBeacon does not wait 
* for a reply, only guarantees it sends even as the page closes
**************************************************************************@
<script>
    const cameraIdList = [
        @foreach (var cam in ViewBag.Cameras)
        {
            @:"@cam.Id",
        }
    ];
    window.addEventListener("pagehide", function() {
        cameraIdList.forEach(function(id) {
            navigator.sendBeacon("/Camera/DestroyStream/" + id);
        })
    })
</script>




