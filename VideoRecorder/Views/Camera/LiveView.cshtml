@model VideoRecorder.Models.Camera;
@{
    ViewData["Title"] = "Live View";
}

<div style="max-width:960px; 
    margin:16px auto; position:relative; background:#0d0a16; border:1px solid #3C3489; border-radius:8px; overflow:hidden; aspect-ratio:16/9; display:flex; align-items:center; justify-content:center;">

    <video id="video" muted playsinline style="width:100%; height:100%; object-fit:cover;"></video>

    <span style="position:absolute; top:8px; left:8px; font-size:10px; color:#7F77DD; font-family:monospace; opacity:.7;">CAM-@Model.Name</span>

    <div style="position:absolute; bottom:0; left:0; right:0; padding:6px 10px; background:linear-gradient(transparent,rgba(13,10,22,.9)); display:flex; align-items:center; justify-content:space-between;">

        <span style="font-size:12px; font-weight:500; color:#AFA9EC; font-family:monospace;">@Model.Name</span>

        <span style="display:flex; align-items:center; gap:5px; font-size:11px; font-family:monospace; color:@(Model.IsOnline ? "#5DCAA5" : "#E24B4A");">
            <span style="width:6px; height:6px; border-radius:50%; background:@(Model.IsOnline ? "#5DCAA5" : "#E24B4A"); display:inline-block;"></span>
            @(Model.IsOnline ? "LIVE" : "OFFLINE")
        </span>
    </div>
</div>


@************************************************************************
* find the video element, then create a new HLS player instance.
* tell HLS.js where the stream is. index.m3u8 is the playlist 
* file mediamtx generates - a text file that says where the video chunks are.
* listen for the event after playlist file is parsed
* next, we wait 5 secs for ffmpeg to connect
**************************************************************************@
@* <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script> *@

<script src="~/js/hls.min.js"></script>

<script>
    
    if (Hls.isSupported()) {
        const video = document.getElementById("video");
        video.removeAttribute('src');
        
        const hls = new Hls({
            manifestLoadingMaxRetry: 10,
            manifestLoadingRetryDelay: 2000,
            manifestLoadingMaxRetryTimeout: 64000,
        });
        setTimeout(function() {
            hls.loadSource('http://localhost:8888/live/@ViewData["CameraId"]/index.m3u8');
            hls.attachMedia(video);
            hls.on(Hls.Events.MANIFEST_PARSED, function() {
                video.play();
            });
            
            hls.on(Hls.Events.ERROR, function(event, data) {
                if (data.details === Hls.ErrorDetails.MANIFEST_LOAD_ERROR ||
                    data.details === Hls.ErrorDetails.MANIFEST_LOAD_TIMEOUT) {
                    console.log('Retrying stream... attempt: ' + data.context.retryCount);
                }

                if (data.fatal) {
                    Swal.fire({
                        title: 'Stream unavailable.',
                        text: 'Could not connect to camera.',
                        icon: 'error',
                        background: '#1a1a2e',
                        color: '#ffffff'
                    });
                }
            });
        }, 5000);
    }
    
</script>

@************************************************************************
* Javascript to listen for the "back button clicked".
* For this, we are using sendBeacon. sendBeacon does not wait 
* for a reply, only guarantees it sends even as the page closes
**************************************************************************@
<script>
    const cameraId = "@ViewData["CameraId"]";
    
    window.addEventListener("pagehide", function() {
            navigator.sendBeacon("/Camera/DestroyStream/" + cameraId);
        });
</script>
